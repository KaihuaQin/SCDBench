  "outcome_definitions": {
    "abi_exact_cumulative": "One when ABI evaluation has no false-positive or false-negative signatures; zero when recovery is inexact or a prerequisite fails.",
    "abi_f1_cumulative": "Per-contract ABI F1 from the evaluator, with zero assigned when format or compilation failure prevents ABI evaluation.",
    "compile_pass": "One when the final artifact after repair compiles; zero otherwise.",
    "format_pass": "One when the original decompilation output passes the output format protocol; zero otherwise. Repair is downstream and cannot erase an original format success.",
    "semantic_perfect_cumulative": "One when the contract has at least one ABI function, ABI recovery has no false positives or false negatives, and every ground-truth ABI function passes all semantic cases; zero otherwise.",
    "semantic_rate_cumulative": "Number of ground-truth public-function signatures that pass every stored semantic case divided by all benchmark semantic entries for the contract, including fallback and receive entries; missing or ineligible entries contribute zero."
